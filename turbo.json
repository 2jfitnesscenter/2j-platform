{
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "@2j/domain#build"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "src/tokens.css"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
