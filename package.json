{
  "name": "2j-platform",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "seed:demo": "pnpm --filter @2j/api seed:demo",
    "pilot": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/start-local-pilot.ps1",
    "pilot:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/start-local-pilot.ps1 -Stop",
    "owner:review": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/start-local-pilot.ps1 -OwnerReview",
    "owner:review:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/start-local-pilot.ps1 -OwnerReview -Stop",
    "admin:release:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/deploy/prepare-admin-pilot-release.ps1 -PrepareOnly",
    "test": "pnpm --filter @2j/design-tokens test && pnpm --filter @2j/domain test && pnpm --filter @2j/permissions test && pnpm --filter @2j/ui test && pnpm --filter @2j/auth test && pnpm --filter @2j/audit test && pnpm --filter @2j/api test && pnpm --filter @2j/admin-web test && pnpm --filter @2j/client-app test && pnpm --filter @2j/staff-app test && pnpm run test:deploy-kit",
    "test:deploy-kit": "node --test tooling/deploy/*.test.mjs tooling/staging/*.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "exceljs>uuid": "^11.1.1",
      "xcode>uuid": "^11.1.1",
      "undici": "^8.12.3",
      "fast-uri@^3.0.0": "^3.1.9",
      "fast-uri@^4.0.0": "^4.2.3"
    }
  }
}
