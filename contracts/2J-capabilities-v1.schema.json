{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2jfitnesscenter.com/contracts/2J-capabilities-v1.schema.json",
  "title": "2J Platform Training Capabilities V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "personId", "trainingSubject", "capabilityLevel", "accessState", "capabilities", "reasonCode", "effectiveFrom", "expiresAt", "generatedAt", "source"],
  "properties": {
    "contract": { "const": "2J-CAPABILITIES-V1" },
    "version": { "const": 1 },
    "personId": { "type": "string", "format": "uuid" },
    "trainingSubject": {
      "type": "object", "additionalProperties": false, "required": ["linkStatus"],
      "oneOf": [
        { "properties": { "linkStatus": { "const": "active" } }, "required": ["trainingUserId"] },
        { "properties": { "linkStatus": { "enum": ["not_linked", "revoked"] } }, "not": { "required": ["trainingUserId"] } }
      ],
      "properties": {
        "linkStatus": { "enum": ["active", "not_linked", "revoked"] },
        "trainingUserId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "capabilityLevel": { "enum": ["full", "autonomous", "blocked"] },
    "accessState": { "enum": ["active", "provisional", "blocked_unpaid", "ended"] },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["autonomousTraining", "routineCreation", "guidedTraining", "premiumPrograms", "aiCoach", "professionalFollowUp"],
      "properties": {
        "autonomousTraining": { "type": "boolean" }, "routineCreation": { "type": "boolean" },
        "guidedTraining": { "type": "boolean" }, "premiumPrograms": { "type": "boolean" },
        "aiCoach": { "type": "boolean" }, "professionalFollowUp": { "type": "boolean" }
      }
    },
    "reasonCode": { "enum": ["ACTIVE_FULL", "ACTIVE_AUTONOMOUS", "PROVISIONAL_FULL", "PROVISIONAL_AUTONOMOUS", "UNPAID_BLOCK", "NO_ACTIVE_MEMBERSHIP", "PERIOD_ENDED", "TRAINING_LINK_REVOKED", "TRAINING_LINK_MISSING"] },
    "effectiveFrom": { "type": ["string", "null"], "format": "date" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object", "additionalProperties": false, "required": ["platform"], "properties": { "platform": { "const": true } } }
  }
}
