        "success": "#26734a", "warning": "#865900", "danger": "#a83232", "info": "#285f91", "focus": "#285f91"
      }
    },
    "dark": {
      "color": {
        "canvas": "#10130f", "surface": "#171b15", "surfaceRaised": "#1e241b", "surfaceSubtle": "#252d21",
        "textPrimary": "#f2f5ee", "textSecondary": "#aab5a2", "textOnBrand": "#14210d",
        "border": "#343d2f", "borderStrong": "#56634d", "brand": "#73b52e", "brandStrong": "#91c65c",
        "success": "#80d5a0", "warning": "#f4c36b", "danger": "#ff9690", "info": "#8fc8ff", "focus": "#8fc8ff"
