DATABASE_URL=postgres://2j_local:2j_local_dev_only@127.0.0.1:54329/2j_platform
HOST=127.0.0.1
PORT=3100
# Optional local-only session context for synthetic development records. Requires NODE_ENV=development.
# LOCAL_DEMO_ROLE=admin

# Outbound Training proof service configuration only. These values never enable service traffic:
# the internal trainingVerifiedLinkingEnabled and trainingServiceCallsEnabled options remain OFF
# by default and both must be explicitly enabled by the host application. Keep credentials in the
# runtime secret store; do not commit a populated file.
TRAINING_SERVICE_BASE_URL=
TRAINING_SERVICE_KEY_ID=
TRAINING_SERVICE_SECRET=

# One-time Training SSO (Platform -> Bunker). OFF by default; names only, never commit populated values.
# PLATFORM_INTERNAL_SERVICE_KEYS is a JSON object {"<keyId>":{"caller":"bunker|home","secret":"<base64url>=32+ bytes"}} kept in the runtime secret store.
# TRAINING_SSO_REDIRECT_URL is the fixed Bunker redeem page (https, or loopback http for local tests); the code is appended as a URL fragment.
PLATFORM_INTERNAL_SERVICE_KEYS=
TRAINING_SSO_ENABLED=false
TRAINING_SSO_REDIRECT_URL=

# Training link lifecycle, provisioning, passkeys and proxy trust (names only; every flag OFF by default; never commit populated values).
# Provisioning and passkeys are refused by the server outside NODE_ENV=development|test until a later, explicitly approved phase.
TRAINING_VERIFIED_LINKING_ENABLED=false
TRAINING_CANONICAL_LINKING_ENABLED=false
TRAINING_LINK_LIFECYCLE_ENABLED=false
TRAINING_PROVISIONING_ENABLED=false
PLATFORM_PASSKEYS_ENABLED=false
# Exact host of the Home member app, for example home.2jfitnesscenter.com. A parent domain is refused. Immutable once credentials exist.
PLATFORM_PASSKEY_RP_ID=
# Exact addresses (or CIDRs no wider than /16) of the reverse proxies allowed to set X-Forwarded-For/-Proto. Empty = trust none.
PLATFORM_TRUSTED_PROXIES=
